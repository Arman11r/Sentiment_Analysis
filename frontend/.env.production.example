# Copy this file's keys into Vercel → Project → Settings → Environment Variables
# Replace values with your real ones.

# Your Render backend URL (e.g. https://sentimentsphere-backend.onrender.com/api)
VITE_API_BASE_URL=https://your-render-backend.onrender.com/api

# Your OMDB API key
VITE_OMDB_API_KEY=your_omdb_key_here
